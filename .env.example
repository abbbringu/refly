# ============================================================
# Refly — Local Self-Hosted Configuration
# ============================================================
# Copy to .env (`cp .env.example .env`) or run `./scripts/setup.sh`
# to generate unique local secrets automatically.

# Open-source self-hosted mode (unlocks all features, disables Stripe billing)
NEXT_PUBLIC_SELF_HOSTED="true"

# Local Docker ports
REFLY_PORT="3000"
SUPABASE_PORT="8000"
POSTGRES_PORT="54322"

# Public URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="http://localhost:8000"

# Local Postgres & Auth secrets (default local-dev values — run ./scripts/setup.sh to rotate)
POSTGRES_PASSWORD="refly-local-postgres-password"
JWT_SECRET="refly-local-dev-jwt-secret-change-me-32chars"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzM1Njg5NjAwLCJleHAiOjIwNTEyMjI0MDB9.Frw2CP5sopsDj3cqfRfincYWOWHhaAssOmkTzJe4a0k"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UiLCJpYXQiOjE3MzU2ODk2MDAsImV4cCI6MjA1MTIyMjQwMH0.fGc7AzwcPfP5VZ6N3PLfW_j1UIflZhBMNBZgYx3T_PY"

# Direct Postgres connection (used for Prisma & maintenance scripts)
DATABASE_URL="postgresql://postgres:refly-local-postgres-password@localhost:54322/postgres"

# ── Optional AI Features ────────────────────────────────────
# Refly works without any AI keys (library, folders, tags, notes, PDFs,
# DOI/arXiv/PubMed/BibTeX/RIS import & export, citations, teams).
#
# To enable AI Chat, Semantic Search, AI Citations, Auto-Tag & Auto-Summary:
#   - OPENROUTER_API_KEY: multi-model chat (GPT, Claude, Gemini, etc.)
#   - OPENAI_API_KEY: embeddings (also works as a fallback for chat if OpenRouter isn't set)
#   - AI_CHAT_BASE_URL: use any OpenAI-compatible server (e.g. Ollama: http://host.docker.internal:11434/v1)
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""

# Optional AI model & endpoint overrides
OPENROUTER_CHAT_MODEL="openai/gpt-5.4"
OPENAI_EMBEDDING_MODEL="text-embedding-3-large"
OPENAI_EMBEDDING_DIMENSIONS="3072"
# AI_CHAT_BASE_URL=""
# AI_CHAT_API_KEY=""
# AI_CHAT_MODEL=""
# OPENAI_BASE_URL=""

# ── Optional Cloud / Stripe Billing (only if NEXT_PUBLIC_SELF_HOSTED="false") ──
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRICE_PLUS_MONTHLY=""
# STRIPE_PRICE_PRO_MONTHLY=""
