{
  "name": "refly",
  "version": "0.1.0",
  "description": "Open-source, self-hosted AI research workspace for academic papers, PDFs, notes, citations, and grounded RAG chat.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "setup": "bash scripts/setup.sh",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:backend": "docker compose up -d gateway",
    "docker:logs": "docker compose logs -f app",
    "lint": "eslint",
    "test": "vitest run",
    "test:unit": "vitest run 'lib/**/*.test.ts'",
    "test:integration": "vitest run 'app/api/**/*.test.ts'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:db:pull": "prisma db pull",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:create": "prisma migrate dev --create-only",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "supabase:db:url": "node scripts/supabase-db-url.mjs",
    "ai:backfill-embeddings": "pnpm dlx tsx scripts/backfill-embeddings.ts",
    "ai:backfill-paper-chunks": "pnpm dlx tsx scripts/backfill-paper-chunks.ts",
    "data:cleanup-paper-files": "pnpm dlx tsx scripts/cleanup-paper-file-artifacts.ts"
  },
  "dependencies": {
    "@citation-js/plugin-bibtex": "^0.7.21",
    "@citation-js/plugin-csl": "^0.7.22",
    "@citation-js/plugin-ris": "^0.7.21",
    "@prisma/client": "^6.16.2",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "ai": "^3.4.33",
    "citation-js": "^0.7.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "katex": "^0.16.45",
    "lucide-react": "^1.8.0",
    "next": "16.1.7",
    "next-themes": "^0.4.6",
    "openai": "^4.104.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "stripe": "^18.5.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.1.7",
    "jsdom": "^29.1.1",
    "postcss": "^8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prisma": "^6.16.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
